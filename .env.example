# =====================================================================
# Web3 University — 根级环境变量 (root .env)
# 复制为 .env 后填写。.env 已在 .gitignore,严禁提交到仓库。
#
# 加载范围:apps/api、apps/worker、packages/contracts/scripts、scripts/*、
# docker-compose 都会读这一份。apps/web 单独读 apps/web/.env(因为 Vite
# 只会注入 VITE_ 前缀变量到前端 bundle)。
#
# 本地开发假设:
#   - PostgreSQL 已通过 brew / Postgres.app / 其它方式运行在 :5432;
#     下方 DATABASE_URL 默认 xweb3 用户,需要:
#       createuser -s xweb3
#       createdb -O xweb3 xweb3
#       createdb -O xweb3 xweb3_test
#   - Redis + Anvil 通过 `docker compose -f deploy/docker-compose.yml up -d` 启动。
#   - 若需要连其它端口/用户/库名,直接改下面 DATABASE_URL / REDIS_URL 即可。
#
# ===== 本地 Anvil 最小闭环 (PR-A6) =====
# 复制 .env.example → .env 后,下面 5 行就能跑通 happy path (其它留空 / 默认值即可):
#   DATABASE_URL=postgres://xweb3:xweb3@localhost:5432/xweb3?sslmode=disable
#   ANVIL_RPC_URL=http://localhost:8545
#   WORKER_RPC_URLS=http://localhost:8545
#   SIGNER_DRIVER=anvil
#   CERT_NFT_ADDRESS=<DeployCertificateNFT 输出的地址>
# 详细步骤见 docs/dev/anvil-loop.md。
# =====================================================================


# =====================================================================
# Database (本地 PostgreSQL,api + worker 共用)
# =====================================================================

# 主库连接串 — api 启动时必填,worker 也会复用。
# 格式:postgres://<user>:<password>@<host>:<port>/<db>?sslmode=disable
# 默认用户名=密码=xweb3 (dev 约定;生产 / 多人开发别这么用)。
# 备选:postgres://xweb3:xweb3@127.0.0.1:5432/xweb3?sslmode=disable
DATABASE_URL=postgres://xweb3:xweb3@localhost:5432/xweb3?sslmode=disable

# 测试库连接串 — 仅跑集成测试 (go test ./... -tags=integration) 时使用。
# 必须与 DATABASE_URL 不同库名,否则测试会污染 dev 数据。
# 用 createdb -O xweb3 xweb3_test 预先创建。
DATABASE_URL_TEST=postgres://xweb3:xweb3@localhost:5432/xweb3_test?sslmode=disable


# =====================================================================
# Redis (docker-compose 起,端口默认)
# =====================================================================

# Redis 连接串,用于 api session / 限流 / 任务队列。
# 格式:redis://[:<password>@]<host>:<port>/<db>
# 默认 db=0;测试建议 db=1 避免冲突。
REDIS_URL=redis://localhost:6379/0


# =====================================================================
# API Server (apps/api)
# =====================================================================

# API HTTP 监听端口。docker-compose 默认 8080,容器内访问用 :8080。
API_PORT=8080

# 运行环境标识,影响日志级别、是否启用 dev stub、是否要求 cookie-secure。
# 合法值:dev | staging | prod。CI 默认 dev;生产必须 prod。
API_ENV=dev

# API 对外 base URL — 用于生成回调 / 邮件链接 / CORS 校验。
# dev 默认 http://localhost:8080;生产填 https://api.<your-domain>。
API_BASE_URL=http://localhost:8080

# 前端 origin,CORS 白名单主源。dev 默认 http://localhost:5173;
# 生产填实际前端域名。多个域用逗号分隔 (api 启动时会 trim)。
WEB_ORIGIN=http://localhost:5173


# =====================================================================
# Privy (钱包登录)
# =====================================================================

# Privy 应用 ID。从 https://dashboard.privy.io/ 创建应用后获取。
# 这是公开值(可放进前端 VITE_PRIVY_APP_ID),不是 secret。
PRIVY_APP_ID=

# Privy JWKS endpoint — 后端用此拉公钥校验 access token 签名。
# 默认模板:https://auth.privy.io/api/v1/${PRIVY_APP_ID}/jwks.json
# 私有部署 / 代理时才需要改。dev 可留空(配合 PRIVY_DEV_STUB=1 走 stub)。
PRIVY_JWKS_URL=

# DEV ONLY:启用 Privy stub 校验器,接受任意 token 并把 subject 固定为
# PRIVY_DEV_STUB_SUBJECT。**仅本地开发使用,严禁在 staging/prod 打开**
# (config.go 会在 staging/prod 启动时 fail-fast 拒绝)。
# 取值 1 = 启用,0 = 走真实 JWKS 校验。
PRIVY_DEV_STUB=1

# 当 PRIVY_DEV_STUB=1 时,所有请求都会被认作这个 subject。
# 仅用于本地联调 + Playwright E2E,不要写真实用户 ID。
PRIVY_DEV_STUB_SUBJECT=did:privy:dev-1


# =====================================================================
# Session (服务端 session 签名 + cookie)
# =====================================================================

# 用于 HMAC 签名 session ID 的密钥。**生产环境为 secret**,必须随机 32 字节 hex。
# 生成命令:openssl rand -hex 32
# 长度 < 32 字节时 api 启动会 fail。怀疑泄露立刻轮换 + 强制下线旧 session。
SESSION_SECRET=dev-secret-replace-me-with-32-byte-hex-xxxxxxxxxxxxxxxx

# session 有效期 (小时)。默认 168 = 7 天。生产可缩短到 24-72h。
SESSION_TTL_HOURS=168

# 是否强制 cookie Secure 标志 (HTTPS only)。
# dev 必须 0 (本地 HTTP);**生产必须 1**,config.go 在 prod 启动时强制校验。
SESSION_COOKIE_SECURE=0


# =====================================================================
# Wallet binding (EIP-191 签名登录)
# =====================================================================

# 钱包签名里的 domain 字段。用于防止跨站签名重放。
# dev 默认 localhost:8080;**生产必须设为 api 实际 host**,否则签名校验失败。
API_DOMAIN=localhost:8080

# 钱包绑定 nonce 有效期 (秒)。默认 300 = 5 分钟,过期需要重新申请 nonce。
WALLET_NONCE_TTL_SECONDS=300

# 邮箱/密码登录速率限制 (每 IP 每分钟)。防爆破。
LOGIN_RATE_LIMIT_PER_MINUTE=10

# 钱包签名绑定速率限制 (每 IP 每分钟)。防 nonce 滥用。
WALLET_RATE_LIMIT_PER_MINUTE=5


# =====================================================================
# Worker / Chain (apps/worker)
# =====================================================================

# Sepolia JSON-RPC endpoint。worker admin/sync 任务 (reconcile、treasury monitor) 用。
# 推荐:https://ethereum-sepolia-rpc.publicnode.com (无 key、限流较宽)
# 或者 Alchemy/Infura 的 -sepolia 子域 + 你的项目 key。
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# 本地 Anvil HTTP RPC,worker 跑订单确认 / 证书铸造默认链。
# 启动 anvil:anvil --host 0.0.0.0 --port 8545
# 或 docker compose up anvil。
ANVIL_RPC_URL=http://localhost:8545

# 区块确认深度。订单确认、证书铸造等需要等待 N 个区块后再认为 final。
# 1 = 适合本地 anvil 即时确认;Sepolia 推荐 5-12。
CHAIN_CONFIRMATION_DEPTH=1

# 业务链 ID,worker 默认链。本地 anvil=31337;Sepolia=11155111。
WORKER_CHAIN_ID=31337

# CourseMarket 合约地址,worker 用它订阅 OrderPurchased / PriceUpdated 事件。
# 从 packages/contracts/script/DeployCourseMarket.s.sol 部署输出回填。
COURSE_MARKET_ADDRESS=

# worker 子系统入口。可选:indexer | cert-consumer | all。
# dev 默认 indexer(只跑订单索引),本地最小闭环时设。
WORKER_CONSUMER=indexer

# 逗号分隔的 worker RPC fallback 列表 (HTTP)。用于链头断流时切换。
# 留空 → 只用 ANVIL_RPC_URL(本地模式)。
WORKER_RPC_URLS=http://localhost:8545

# 逗号分隔的 CourseMarket 多市场地址列表 (用于多实例或迁移期同时监听)。
WORKER_MARKET_ADDRESSES=0xYourCourseMarketAddress

# 可选 WebSocket RPC,worker 用它订阅新区块头。
# 留空则走 HTTP polling。本地 anvil 不支持 WS,留空即可。
WORKER_WS_URL=

# Reconcile scanner 周期 (分钟)。0 = 禁用。用于周期性比对 DB intent vs 链上状态。
RECONCILE_INTERVAL_MINUTES=30

# /metrics 端点 bind 地址,例如 :9090。空字符串 = 禁用 HTTP metrics server。
WORKER_METRICS_ADDR=


# =====================================================================
# Worker: Certificate signer (PR-A3)
# =====================================================================

# signer driver 选择。可选:anvil | keystore | kms。
#   anvil   — 本地开发专用,用明文私钥 (SIGNER_ANVIL_PRIVATE_KEY)。
#   keystore — 加密 JSON keystore + 密码,适合小团队 staging。
#   kms     — AWS KMS / GCP KMS 远程签名,生产推荐。
# 留空 → CertConsumer 跳过证书铸造,worker 仍跑其它子系统。
SIGNER_DRIVER=anvil

# 已部署 CertificateNFT 合约地址。CertConsumer 铸造证书时调用 mint(to, uri)。
# 从 packages/contracts/script/DeployCertificateNFT.s.sol 部署输出回填。
CERT_NFT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# anvil driver 用 — Anvil 默认 account #0 私钥 (well-known test key)。
# **这是公开测试私钥,仅本地开发使用;生产必须留空**,其它 driver 启动会
# fail-fast 检测到非空就报错。
SIGNER_ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# 期望的 signer 公开地址。worker 启动期会校验 from address == 此值,
# 防止 signer 账户错配。留空 → 跳过启动期一致性校验。
# 应该与链上 MINTER_ROLE 持有者地址一致 (DeployCertificateNFT 时设的 minter)。
CERT_MINTER_ADDRESS=

# keystore driver 用 — 加密 JSON keystore 文件路径 (绝对路径或相对 repo 根)。
SIGNER_KEYSTORE_PATH=

# keystore driver 用 — keystore 解密密码。**为 secret**,生产走 secrets manager。
SIGNER_KEYSTORE_PASSWORD=

# kms driver 用 — AWS KMS Key ID (arn:aws:kms:...:key/<id>) 或别名。
SIGNER_KMS_KEY_ID=


# =====================================================================
# Deployer / Etherscan (与 packages/contracts/.env 共享)
# =====================================================================
# 推荐做法:在 packages/contracts/.env 填这些值,这里保留同步副本。
# 部署脚本 (forge script) 走 dotenv -e 自动加载 packages/contracts/.env。

# 部署者热钱包私钥,**HEX 格式**。Solidity 脚本读这个变量;前端不应读到。
# 部署前请肉眼校验:
#   1. 专用账户,不是主仓;Sepolia 余额 ≥ 0.05 ETH。
#   2. https://sepoliafaucet.com/ 取水。
#   3. 这个账户只用来部署 / 跑 worker signer,不参与任何业务交互。
DEPLOYER_PRIVATE_KEY=

# Etherscan API key,部署后自动 verify 合约源码用。
# 申请:https://etherscan.io/apis (Sepolia chain 共享一个 key)。
ETHERSCAN_API_KEY=


# =====================================================================
# Worker: Treasury monitor (PR-A5)
# =====================================================================

# 全部留空 → worker log info「treasury_monitor_disabled_empty」跳过该子系统。
# 本地 dev 允许不配,生产必须配齐以下地址。

# 轮询周期 (Go duration 语法)。5m / 30s / 1h 都合法。默认 5m。
TREASURY_POLL_INTERVAL=5m

# CSV — 主 treasury 地址列表 (逗号分隔)。低于 TREASURY_MIN_ETH_WEI 触发告警。
TREASURY_ADDRESSES=

# CSV — 业务热钱包地址列表 (逗号分隔)。同上。
HOT_WALLET_ADDRESSES=

# 单地址 — 证书 minter 账户。worker 会校验其 ETH 余额是否能支撑下一笔铸造。
MINTER_ADDRESS=

# ERC20 — YD 合约地址。**非零时**启用 YD 余额阈值告警 (低于 YD_MIN_BALANCE 触发)。
# 留空 → 跳过 YD 监控。
YD_TOKEN_ADDRESS=

# 阈值:任一监控地址 ETH 余额低于此值 (wei) → 触发告警。
# 默认 0.1 ETH = 1e17 wei。
TREASURY_MIN_ETH_WEI=100000000000000000

# 阈值:YD 合约总供应或主金库余额低于此值 (最小单位) → 触发告警。
# 默认 1,000,000 YD (假设 18  decimals) = 1e24。
YD_MIN_BALANCE=1000000000000000000000000


# =====================================================================
# Frontend passthrough (apps/web/.env 也会读这些,Vite 需 VITE_ 前缀)
# =====================================================================
# 这里写的值会被 apps/web 通过 docker-compose / CI 注入到前端 bundle,
# 但前端 bundle 只接受 VITE_* 变量。所以这里只是占位说明,
# 真正生效请编辑 apps/web/.env。

# 前端调用后端的 base URL。dev 默认走 Vite proxy (localhost:8080/api/v1)。
VITE_API_BASE_URL=http://localhost:8080/api/v1

# 前端默认连接的目标链 ID。本地 anvil=31337;Sepolia=11155111。
VITE_TARGET_CHAIN_ID=31337

# 前端默认 RPC。dev 默认 127.0.0.1:8545。
VITE_RPC_URL=http://127.0.0.1:8545

# 前端 Anvil 专用 RPC,只在 TARGET_CHAIN_ID=31337 时使用。
VITE_ANVIL_RPC_URL=http://127.0.0.1:8545

# 前端 Sepolia RPC。生产换 Alchemy/Infura + 项目 key。
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# 前端 Privy App ID (公开值)。对应后端 PRIVY_APP_ID。
VITE_PRIVY_APP_ID=

# 前端 Privy stub 开关。dev=1;staging/prod=0。
VITE_PRIVY_DEV_STUB=1

# 示例合约地址 (Counter — 教学 demo)。本地 anvil 部署后回填。
VITE_COUNTER_CONTRACT_ADDRESS=

# Notepad 合约地址 (链上记事本 demo)。同上。
VITE_NOTEPAD_CONTRACT_ADDRESS=

# CourseMarket 主合约地址。F03~F05 业务核心。
VITE_COURSE_MARKET_ADDRESS=

# YDToken 合约地址 (ERC20)。
VITE_YD_TOKEN_ADDRESS=

# CertificateNFT 合约地址 (SBT 凭证)。
VITE_CERTIFICATE_NFT_ADDRESS=

# PriceOracle 适配器地址 (Chainlink feed wrapper)。
VITE_PRICE_ORACLE_ADDRESS=


# =====================================================================
# Price Oracle (ChainlinkPriceOracle 适配器 + mock)
# =====================================================================

# 底层 Chainlink-compatible feed 地址 (Sepolia:ETH/USD 或类似测试对)。
# DeployPriceOracle 脚本从这里读;mock 测试可以指 mock aggregator。
PRICE_FEED_ADDRESS=

# Oracle 报价最大允许陈旧时间 (秒)。超过此值的 roundData 视为不可信,revert StalePrice。
# 默认 3600 = 1 小时。短窗口测试可设 60。
ORACLE_MAX_AGE_SECONDS=3600

# Oracle 报价 decimals。Chainlink 大多数 feed 是 8;mock 测试保持 8 一致。
# **改动需同步前端 formatPrice 函数**,否则显示价格错位。
ORACLE_DECIMALS=8

# Mock oracle 初始答案 (最小单位)。默认 1.00000000 USD/YD = 100000000 (8 decimals)。
# 仅 DeployTestOracle.s.sol 使用。
ORACLE_INITIAL_ANSWER=100000000