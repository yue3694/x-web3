# =====================================================================
# Sepolia (Ethereum testnet) — used by Foundry scripts & wagmi
# Docs: https://docs.ethers.org/  |  https://sepolia.etherscan.io/
# =====================================================================

# Alchemy / Infura / public RPC endpoint for Sepolia.
# Examples:
#   https://eth-sepolia.g.alchemy.com/v2/<KEY>
#   https://sepolia.infura.io/v3/<KEY>
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Etherscan V2 API key — required for contract verification on Sepolia.
# Get one at https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Hex private key (no 0x prefix required, but accepted) of the deployer.
# The account MUST hold Sepolia ETH — get some from
#   https://sepoliafaucet.com/  or  https://cloud.google.com/application/3/sep
DEPLOYER_PRIVATE_KEY=

# (Optional) Optional account to send transactions from in the frontend.
# Same format as DEPLOYER_PRIVATE_KEY.
FRONTEND_WALLET_PRIVATE_KEY=