# =====================================================================
# Web3 University — environment variables
# Copy to .env (root) and fill in. NEVER commit .env.
#
# 本地开发假设：
#   - PostgreSQL 已经通过 brew / Postgres.app / 其它方式运行在 :5432；
#     下方 DATABASE_URL 默认 xweb3 用户，需要 `createuser -s xweb3` +
#     `createdb -O xweb3 xweb3` + `createdb -O xweb3 xweb3_test`。
#   - Redis + Anvil 通过 `docker compose -f deploy/docker-compose.yml up -d` 启动。
#   - 若你希望连其它端口/用户/库名，直接改下面两行即可。
#
# ===== 本地 Anvil 最小闭环（PR-A6）=====
# 复制 .env.example → .env 后，下面 5 行就能跑通 happy path（其它留空 / 默认值即可）：
#   DATABASE_URL=postgres://xweb3:xweb3@localhost:5432/xweb3?sslmode=disable
#   ANVIL_RPC_URL=http://localhost:8545
#   WORKER_RPC_URLS=http://localhost:8545
#   SIGNER_DRIVER=anvil
#   CERT_NFT_ADDRESS=<DeployCertificateNFT 输出的地址>
# 详细步骤见 docs/dev/anvil-loop.md。
# =====================================================================

# ===== Database (local PostgreSQL) =====
# 默认用户名=密码=xweb3（dev 约定；生产 / 多人开发别这么用）
DATABASE_URL=postgres://xweb3:xweb3@localhost:5432/xweb3?sslmode=disable
DATABASE_URL_TEST=postgres://xweb3:xweb3@localhost:5432/xweb3_test?sslmode=disable

# ===== Redis (docker-compose 起) =====
REDIS_URL=redis://localhost:6379/0

# ===== Server =====
API_PORT=8080
API_ENV=dev
API_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:5173

# ===== Privy =====
# Get from https://dashboard.privy.io/
# Privy verifies the access token via JWKS at:
#   https://auth.privy.io/api/v1/${PRIVY_APP_ID}/jwks.json
PRIVY_APP_ID=
PRIVY_JWKS_URL=
# Privy access-token audience is always validated against PRIVY_APP_ID.
# DEV ONLY: enable a stub Privy verifier that accepts any token.
# Set PRIVY_DEV_STUB=1 and PRIVY_DEV_STUB_SUBJECT=<string> to bypass JWT
# verification in local dev. NEVER enable in staging/prod.
PRIVY_DEV_STUB=1
PRIVY_DEV_STUB_SUBJECT=did:privy:dev-1

# ===== Session =====
# Random 32-byte hex; rotate on suspected leak. Production: AWS Secrets Manager.
# Generate: openssl rand -hex 32
SESSION_SECRET=dev-secret-replace-me-with-32-byte-hex-xxxxxxxxxxxxxxxx
SESSION_TTL_HOURS=168
# Production must set this to 1. Local HTTP development keeps it disabled.
SESSION_COOKIE_SECURE=0

# ===== Wallet binding =====
# API domain used in wallet-binding EIP-191 signatures (anti cross-site abuse).
API_DOMAIN=localhost:8080
WALLET_NONCE_TTL_SECONDS=300
LOGIN_RATE_LIMIT_PER_MINUTE=10
WALLET_RATE_LIMIT_PER_MINUTE=5

# ===== Worker / Chain =====
SEPOLIA_RPC_URL=https://rpc.sepolia.org
ANVIL_RPC_URL=http://localhost:8545
CHAIN_CONFIRMATION_DEPTH=12
WORKER_CHAIN_ID=11155111
WORKER_CONSUMER=indexer
# Comma-separated fallback RPC list (HTTP). If empty, anvil-only mode.
WORKER_RPC_URLS=
# Optional WS URL for head subscription
WORKER_WS_URL=
# Reconcile scanner interval (minutes). 0 disables.
RECONCILE_INTERVAL_MINUTES=30
# /metrics endpoint bind (e.g. :9090). Empty disables HTTP server.
WORKER_METRICS_ADDR=

# ===== Worker: Certificate signer (PR-A3) =====
# driver: anvil | keystore | kms. Empty → CertConsumer 跳过（worker 仍跑其它子系统）。
SIGNER_DRIVER=anvil
# 已部署 CertificateNFT 合约地址
CERT_NFT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# anvil driver 用；生产必须留空（其它 driver 启动期会 fail-fast 检测）
# Anvil default account #0 私钥（well-known test key；仅本地开发使用）
SIGNER_ANVIL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# 声明的「这个 signer 应该是谁」地址；与链上 MINTER_ROLE 持有者一致。
# 留空 → 跳过启动期一致性校验。
CERT_MINTER_ADDRESS=
# keystore driver 用
SIGNER_KEYSTORE_PATH=
SIGNER_KEYSTORE_PASSWORD=
# kms driver 用
SIGNER_KMS_KEY_ID=

# Deployer / Etherscan — 与 packages/contracts/.env 共享；填到对应文件。
DEPLOYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

# ===== Worker: Treasury monitor (PR-A5) =====
# 全空 → worker log info「treasury_monitor_disabled_empty」跳过；本地 dev 允许不配。
# 轮询周期
TREASURY_POLL_INTERVAL=5m
# CSV — 主 treasury 地址（多个逗号分隔）
TREASURY_ADDRESSES=
# CSV — 业务热钱包
HOT_WALLET_ADDRESSES=
# 单地址 — 证书 minter
MINTER_ADDRESS=
# ERC20 — YD 合约地址；非零时启用 YD 余额阈值告警
YD_TOKEN_ADDRESS=
# 阈值：低于此余额 → 告警
TREASURY_MIN_ETH_WEI=100000000000000000   # 0.1 ETH
YD_MIN_BALANCE=1000000000000000000000000  # 1_000_000 * 1e18

# ===== Frontend (apps/web/.env) =====
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
VITE_PRIVY_APP_ID=
VITE_PRIVY_DEV_STUB=1
VITE_COUNTER_CONTRACT_ADDRESS=
VITE_NOTEPAD_CONTRACT_ADDRESS=
