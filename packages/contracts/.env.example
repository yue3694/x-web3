# Foundry 不会自动加载 .env；`vm.envXxx()` 读进程 env 变量。
# package.json 的 deploy:* 脚本已用 `dotenv -e ./.env --` 注入，无需手动 source。
# 复制本文件为 .env 后填值。.env 已在 .gitignore 中，不会被提交。
# Keep these in sync with the root .env.example.

# ⚠️ 变量名 SEPOLIA_RPC_URL 历史踩坑：曾被误填为 Ethereum mainnet RPC，
#    导致 forge script 把合约发到 mainnet、花真 ETH。**部署前肉眼校验 host**
#    是 -sepolia. / sepolia.，绝不能是 eth-mainnet / mainnet。
#    公共节点选项：
#     - https://ethereum-sepolia-rpc.publicnode.com（推荐，无 key、限流较宽）
#     - https://rpc.sepolia.org（基金会，限流严）
#    Alchemy / Infura：填 -sepolia 子域 + 你的项目 key。
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=
# ⚠️ 部署者热钱包私钥（HEX，**不带** 0x 前缀）。专用账户、余额只够付 gas，
#    不要用主仓。Sepolia ETH：https://sepoliafaucet.com/ ≥ 0.05 ETH。
DEPLOYER_PRIVATE_KEY=

# ===== DeployCourseMarket (Mode A) =====
# 支付 ERC20 地址（Mode A 占位 course 用）。Sepolia = MockYD / 待 F05 决议后填真实 YD。
PAYMENT_TOKEN_ADDRESS=

# ===== DeployCourseMarket (Mode B) =====
# 指向 JSON 课程的路径（相对 repo 根或绝对路径均可）。设置后 PAYMENT_TOKEN_ADDRESS 被忽略。
# JSON 形状：[{ "courseKey": "0x..", "token": "0x..", "amount": "<uint>", "priceVersion": <uint> }, ...]
COURSES_CONFIG_PATH=

# ===== DeployYDToken =====
# 生产走多签；本地/测试可直接填 deployer 地址。
YD_TREASURY_MULTISIG=
YD_PAUSER_MULTISIG=
# Mode B：JSON 配置路径（设置后上面两个 env 被忽略）。
YD_CONFIG_PATH=

# ===== DeployCertificateNFT =====
# admin: DEFAULT_ADMIN_ROLE；minter: MINTER_ROLE（worker KMS signer）；
# burner: BURNER_ROLE（运营）。
CERT_NFT_ADMIN_ADDRESS=
CERT_NFT_MINTER_ADDRESS=
CERT_NFT_BURNER_ADDRESS=
CERT_NFT_CONFIG_PATH=

# ===== 通用 =====
# 可选：期望 chain id（默认 11155111 Sepolia）。部署脚本断言 block.chainid 与此一致，
# 防 deploy 错链。
EXPECTED_CHAIN_ID=11155111