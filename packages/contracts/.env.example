# =====================================================================
# packages/contracts — Foundry 部署脚本专用环境变量
# 复制为 .env 后填值。.env 已在 .gitignore 中,不会被提交。
#
# 注意:Foundry (forge/cast/anvil) **不会自动**加载 .env;`vm.envXxx()`
# 读的是当前进程环境变量。package.json 的 deploy:* 脚本已经用
# `dotenv -f ./.env run --` 注入,直接 `pnpm deploy:*:sepolia` 即可,
# 无需手动 source。
#
# 同步:本文件是 root .env 的子集,根 .env 改了这里也要同步。
# Keep these in sync with the root .env.example.
# =====================================================================


# =====================================================================
# RPC + Etherscan + 部署者密钥 (所有部署脚本必填)
# =====================================================================

# Sepolia JSON-RPC endpoint。
# ⚠️ 历史踩坑:曾被误填为 Ethereum mainnet RPC,导致 forge script 把合约
#    发到 mainnet、花真 ETH。**部署前肉眼校验 host** 是 -sepolia. / sepolia.,
#    绝不能是 eth-mainnet / mainnet。
#
# 公共节点选项(无 key):
#   - https://ethereum-sepolia-rpc.publicnode.com (推荐,无 key、限流较宽)
#   - https://rpc.sepolia.org                  (基金会节点,限流严)
# 第三方(需要项目 key):
#   - Alchemy:https://eth-sepolia.g.alchemy.com/v2/<YOUR_KEY>
#   - Infura :https://sepolia.infura.io/v3/<YOUR_KEY>
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Etherscan API key,部署后自动 verify 合约源码用。
# 申请:https://etherscan.io/apis (Sepolia / Mainnet 共享同一个 key)。
# 留空 → 部署脚本跳过 --verify,需后续手动跑 pnpm verify:sepolia。
ETHERSCAN_API_KEY=

# 部署者热钱包私钥，**HEX 格式且带 0x 前缀**。Foundry 1.7 的
# `vm.envUint` 解析十六进制值时要求该前缀。
#   ⚠️ 安全要求:
#     1. **专用账户**,不要用主仓。Sepolia 余额 ≥ 0.05 ETH。
#     2. Sepolia ETH 取水:https://sepoliafaucet.com/
#     3. 这个账户只用来部署 / 跑 worker signer,不参与任何业务交互。
#     4. 任何方式泄露立即轮换 + 把已部署合约 admin 移交走。
#     5. 严禁把这条放进任何会被 git 追踪的文件 / CI 日志。
DEPLOYER_PRIVATE_KEY=

# 本地 Anvil HTTP RPC。仅 DeployTestOracle.s.sol 等 anvil-only 脚本使用。
# 启动 anvil:`anvil --host 0.0.0.0 --port 8545` 或 `docker compose up anvil`。
ANVIL_RPC_URL=http://127.0.0.1:8545


# =====================================================================
# DeployCourseMarket (F03)
# =====================================================================

# CourseMarket owner — DEFAULT_ADMIN_ROLE / 配置课程的权限人。
# 留空 → 默认 deployer(仅本地 / 个人测试用)。
# 共享测试链 / staging 建议填 treasury 多签或 Safe 地址。
COURSE_MARKET_OWNER=

# Mode B:JSON 课程配置路径(相对 repo 根或绝对路径均可)。
# 留空 → Mode A,只部署、不配置(由 owner 后续 configureCourse)。
# 一旦设置,CourseMarket 部署完成后会逐条调用 configureCourse。
#
# JSON 形状:
# [
#   {
#     "courseKey":    "0x<32-byte hex>",
#     "token":        "0x<address>",     // 支付 ERC20
#     "amount":       "<uint256 string>",// 课程价格(最小单位)
#     "priceVersion": <uint256>          // 价格版本号,用于链下/链上对账
#   },
#   ...
# ]
COURSES_CONFIG_PATH=


# =====================================================================
# DeployYDToken (F05)
# =====================================================================

# Treasury 多签地址 — 同时作为:
#   - DEFAULT_ADMIN_ROLE 持有者(角色管理)
#   - MINTER_ROLE 持有者(后续 8 亿 YD 释放)
#   - treasury(构造时 2 亿 YD 接收方)
# 生产:必填,且必须是真实部署过的多签 / Safe。
# 本地:留空也行 — 脚本会把 deployer 当作 admin/minter/treasury。
YD_TREASURY_MULTISIG=

# Pauser 多签地址 — PAUSER_ROLE 持有者。
# 生产:**强烈建议**与 treasury 多签**分开**,避免「金库多签一锅端」风险。
# 本地:留空也行 — 脚本会把 deployer 当作 pauser。
YD_PAUSER_MULTISIG=

# Mode B:JSON 角色配置路径。
# 设置后上面两个 YD_*_MULTISIG env 被忽略。
# JSON 形状(单个对象,四个字段均必填):
# {
#   "admin":    "0x<address>",
#   "minter":   "0x<address>",
#   "pauser":   "0x<address>",
#   "treasury": "0x<address>"
# }
YD_CONFIG_PATH=


# =====================================================================
# DeployCertificateNFT (F04)
# =====================================================================

# admin:DEFAULT_ADMIN_ROLE 持有者。生产建议 treasury 多签 / timelock。
# 本地:留空也行 — 脚本会把 deployer 当作 admin。
CERT_NFT_ADMIN_ADDRESS=

# minter:MINTER_ROLE 持有者 — worker KMS/keystore signer 账户。
# 必须与 worker 启动期校验的 CERT_MINTER_ADDRESS 一致。
# 本地:留空也行 — 脚本会把 deployer 当作 minter。
CERT_NFT_MINTER_ADDRESS=

# burner:BURNER_ROLE 持有者 — 吊销证书的运营账户。
# 留空 → 默认 = admin(同一账户)。
# 生产:建议独立运营账户,不要和 minter 共用。
CERT_NFT_BURNER_ADDRESS=

# Mode B:JSON 角色配置路径。
# 设置后上面三个 CERT_NFT_*_ADDRESS env 被忽略。
# JSON 形状(单个对象,admin / minter 必填,burner 可省略):
# {
#   "admin":  "0x<address>",
#   "minter": "0x<address>",
#   "burner": "0x<address>"   // 可选,缺省 = admin
# }
CERT_NFT_CONFIG_PATH=


# =====================================================================
# 通用:chainid 安全网
# =====================================================================

# 期望 chain id,默认 11155111 (Sepolia)。
# DeployYDToken / DeployCertificateNFT / DeployPriceOracle 启动时断言
# block.chainid 与此值一致,防止 deploy 错链(Mainnet 公共 RPC 也是 https)。
# 本地 anvil 部署这些脚本时设 31337。
# 本地 + Mock oracle 部署请改 31337;DeployTestOracle 写死只允许 31337。
EXPECTED_CHAIN_ID=11155111


# =====================================================================
# Price Oracle
# =====================================================================

# 底层 Chainlink-compatible feed 地址。
# - 本地 anvil:留空,DeployTestOracle.s.sol 会自己起一个 MockV3Aggregator。
# - Sepolia:从 https://docs.chain.link/data-feeds/price-feeds/addresses
#   找 Sepolia 网络对应的 ETH/USD 或 YD/USD feed,**只选 Verified** 的。
# DeployPriceOracle.s.sol 从这里读;mock 测试可以指向 mock aggregator。
PRICE_FEED_ADDRESS=

# Oracle 报价最大允许陈旧时间 (秒)。超过此值的 roundData 视为不可信,revert StalePrice。
# 默认 3600 = 1 小时。
# 短窗口测试可设 60(配合本地 mock 频繁 updateAnswer)。
ORACLE_MAX_AGE_SECONDS=3600

# Oracle 报价 decimals。Chainlink 大多数 feed 是 8。
# **改动需同步前端 formatPrice 函数**,否则显示价格错位 (1e8 vs 1e18)。
# DeployTestOracle 也读这个变量建 mock feed。
ORACLE_DECIMALS=8

# Mock oracle 初始答案 (最小单位)。默认 1.00000000 USD/YD = 100000000 (8 decimals)。
# 仅 DeployTestOracle.s.sol 使用;DeployPriceOracle 不会用。
# 本地测试可调成其它值模拟不同起始价,例:2.5 USD → 250000000。
ORACLE_INITIAL_ANSWER=100000000
