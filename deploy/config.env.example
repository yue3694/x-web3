# Copy to deploy/config.env. The real file is git-ignored.
AWS_REGION=us-east-1
STACK_NAME=x-web3-web
DOMAIN_NAME=notes.example.com
ACM_CERTIFICATE_ARN=
PRICE_CLASS=PriceClass_100

# Cloudflare values are only needed by scripts/configure-cloudflare-dns.sh.
CF_ZONE_ID=
CF_API_TOKEN=

# Filled automatically from CloudFormation output, or set manually.
CLOUDFRONT_DOMAIN=

# Public Vite build values. Contract addresses may remain empty initially.
VITE_APP_URL=https://notes.example.com
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
VITE_WALLETCONNECT_PROJECT_ID=
VITE_COUNTER_CONTRACT_ADDRESS=
VITE_NOTEPAD_CONTRACT_ADDRESS=
