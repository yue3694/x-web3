{
  "name": "@x-web3/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vite + React + wagmi frontend for x-web3",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@privy-io/react-auth": "^2.0.0",
    "@tanstack/react-query": "^5.59.20",
    "@x-web3/shared": "workspace:*",
    "connectkit": "^1.9.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.45",
    "wagmi": "^2.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.13.0",
    "globals": "^17.9.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
