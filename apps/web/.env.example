# =====================================================================
# apps/web — Vite 前端环境变量
# 复制为 .env 后填写。.env 已在 .gitignore,严禁提交到仓库。
#
# 重要:Vite 仅会把以 VITE_ 开头的变量打包进前端 bundle,
# 所以所有「前端需要用到的」变量都必须以 VITE_ 为前缀。
# 任何 *secret*(私钥、API secret、签名 key)禁止放在这里 —
# 只能走后端 / Cloud Function / KMS。
#
# 加载顺序(Vite 默认):
#   .env                通用默认值,所有 mode 加载
#   .env.local          本机覆盖,gitignore
#   .env.<mode>         mode-specific (development / production)
#   .env.<mode>.local   mode-specific 本机覆盖,gitignore
# 我们只用 .env(开发)+ .env.production(生产预发)。
# =====================================================================


# =====================================================================
# Chain RPC & target
# =====================================================================

# 统一 RPC endpoint。建议使用自己的 Alchemy / Infura Sepolia 节点。
VITE_RPC_URL=https://rpc.sepolia.org

# 浏览器通过该 RPC 直连 Sepolia 读取链上数据(read contract、事件回放)。
# 本地开发默认 https://rpc.sepolia.org (公共节点,易限流,仅 dev 凑合用)。
# 生产前换 Alchemy/Infura 并加项目 key,例如:
#   https://eth-sepolia.g.alchemy.com/v2/<YOUR_KEY>
# 申请:https://www.alchemy.com/ 或 https://www.infura.io/
VITE_SEPOLIA_RPC_URL=


# =====================================================================
# App metadata (钱包连接弹窗 / WalletConnect 元数据)
# =====================================================================

# 应用对外 URL,会显示在钱包连接弹窗与签名请求元数据里。
# 仅用于钱包元数据 / 分享链接,**不参与链上逻辑**。
# dev:http://localhost:5173  生产:https://university.inxyu.cn
VITE_APP_URL=https://university.inxyu.cn


# =====================================================================
# WalletConnect
# =====================================================================

# WalletConnect Cloud 项目 ID。仅在引入 walletConnect connector 时必填。
# 没填也能用 MetaMask / Rabby (injected),但 WalletConnect 移动钱包扫码会失败。
# 申请:https://cloud.walletconnect.com (登录后创建一个 Project 即可拿到)
# 这是公开 ID(可进 bundle),不是 secret。
VITE_WALLETCONNECT_PROJECT_ID=


# =====================================================================
# Auth (Privy)
# =====================================================================

# Privy App ID — 前端 SDK 初始化必填,从 https://dashboard.privy.io/ 创建应用后获取。
# 这是公开 ID(会出现在 bundle 里),不是 secret。
# 必须在 dashboard 里把 localhost:5173 加进 allowed origins,否则开发联调失败。
VITE_PRIVY_APP_ID=

# Privy stub 开关:仅本地开发使用,绕过 Privy 真实校验,直接信任前端传入的 subject。
# 取值 1 = 启用 stub(本地默认),0 = 走真实 Privy JWKS 校验(联调 / 预发 / 生产)。
# **严禁在生产打开**(后端 config.go 也会 fail-fast 校验)。
# E2E (playwright.config.ts) 会强制覆盖为 1,与后端 PRIVY_DEV_STUB=1 配合。
VITE_PRIVY_DEV_STUB=1


# =====================================================================
# Backend API
# =====================================================================

# 前端调用后端的 base URL。
# dev 默认走 Vite proxy (vite.config.ts 把 /api/* 转发到 localhost:8080),
#     所以这里可以写 http://localhost:8080/api/v1。
# 生产填实际 API 网关地址(例:https://api.x-web3.example.com/api/v1)。
# 路径必须以 /api/v1 结尾,与后端 router 保持一致;改 path prefix 会同时改 api 的 mount。
VITE_API_BASE_URL=/api/v1


# =====================================================================
# Deployer (脚本用)
# =====================================================================

# 部署者公开地址,仅在某些初始化脚本(例如 initialOwner 注入)里读。
# 公开值,不构成 secret。注意:**对应私钥必须放在根 .env 或 packages/contracts/.env,
# 严禁进前端 bundle**。
VITE_DEPLOYER_ADDRESS=


# =====================================================================
# Contract addresses
# =====================================================================
# 合约地址本身是公开信息(链上任何人都能读到),但为了让前端在编译期就能
# 拿到地址做静态引用 + wagmi config 初始化,需要在这里写死。
# **部署到 Sepolia 之前保持空字符串**;拿到地址后填入并重启 pnpm dev。
#
# Counter 合约地址 — 教学 demo (Counter.sol)。
VITE_COUNTER_CONTRACT_ADDRESS=

# Notepad 合约地址 — 链上记事本 demo (Notepad.sol)。
VITE_NOTEPAD_CONTRACT_ADDRESS=

# CourseMarket 主合约地址 — F03~F05 业务核心,买课 / 下单 / 价格适配都在这里。
# 从 packages/contracts/script/DeployCourseMarket.s.sol 部署输出回填。
VITE_COURSE_MARKET_ADDRESS=

# YDToken 合约地址 (ERC20)。前端做余额查询、转账授权显示。
# 从 DeployYDToken.s.sol 部署输出回填。
VITE_YD_TOKEN_ADDRESS=

# CertificateNFT 合约地址 (SBT 凭证)。前端做凭证查询、二维码生成。
# 从 DeployCertificateNFT.s.sol 部署输出回填。
VITE_CERTIFICATE_NFT_ADDRESS=

# PriceOracle 适配器地址 (Chainlink feed wrapper)。前端做价格预估显示。
# 从 DeployPriceOracle.s.sol 部署输出回填。
# 部署前确认 PRICE_FEED_ADDRESS (在 packages/contracts/.env) 已填。
VITE_PRICE_ORACLE_ADDRESS=

# SepoliaETH -> YD 的唯一兑换合约。
VITE_SEPOLIA_YD_SALE_ADDRESS=
