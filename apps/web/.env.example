# =====================================================================
# apps/web — Vite 前端环境变量
# 复制为 .env 后填写。.env 已在 .gitignore,严禁提交。
#
# 重要:Vite 仅会把以 VITE_ 开头的变量打包进前端 bundle,
# 所以所有「前端需要用到的」变量都必须以 VITE_ 为前缀。
# 任何 *secret*(私钥、API secret、签名 key)禁止放在这里 —
# 只能走后端 / Cloud Function / KMS。
# =====================================================================

# ===== Chain RPC =====
# 浏览器通过该 RPC 直连 Sepolia 读取链上数据。
# - 本地开发:默认 https://rpc.sepolia.org(公共节点,易限流)。
# - 生产:换 Alchemy / Infura 并加 fallback,例如:
#     https://eth-sepolia.g.alchemy.com/v2/<YOUR_KEY>
VITE_SEPOLIA_RPC_URL=

# 应用对外 URL,会显示在钱包连接弹窗与签名请求元数据里。
# 仅用于钱包元数据 / 分享链接,不参与链上逻辑。
VITE_APP_URL=https://university.inxyu.cn

# ===== WalletConnect =====
# WalletConnect Cloud 项目 ID。仅在引入 walletConnect connector 时必填。
# 没填也能用 MetaMask / injected,但 WalletConnect 移动钱包扫码会失败。
# 申请:https://cloud.walletconnect.com (登录后创建一个 Project 即可拿到)
VITE_WALLETCONNECT_PROJECT_ID=

# ===== Auth (Privy) =====
# Privy App ID — 前端 SDK 初始化必填,从 https://dashboard.privy.io/ 创建应用后获取。
# 这是公开 ID(会出现在 bundle 里),不是 secret。
VITE_PRIVY_APP_ID=

# 私钥 stub 开关:仅在本地开发使用,绕过 Privy 真实校验,直接信任前端传入的 subject。
# 取值 1 = 启用 stub(本地默认),0 = 走真实 Privy JWKS 校验(联调 / 预发 / 生产)。
# 严禁在生产打开。
# E2E (playwright.config.ts) 会强制覆盖为 1,与后端 PRIVY_DEV_STUB=1 配合。
VITE_PRIVY_DEV_STUB=1

# ===== Backend =====
# 前端调用后端的 base URL。dev 默认 Vite proxy 转发到 http://localhost:8080,
# 生产填实际 API 网关地址(例:https://api.x-web3.example.com/api/v1)。
# 路径必须以 /api/v1 结尾,与后端 router 保持一致。
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ===== Deployer (脚本用) =====
# 部署者公开地址,仅在某些初始化脚本(例如 initialOwner 注入)里读。
# 公开值,不构成 secret。注意:对应私钥必须放在根 .env,严禁进前端。
VITE_DEPLOYER_ADDRESS=

# ===== Contract addresses =====
# 合约地址本身是公开信息(链上任何人都能读到),但为了让前端在编译期就
# 能拿到地址做静态引用,需要在这里写死。**部署 Sepolia 之前保持空字符串**;
# 拿到地址后填入并重启 pnpm dev。
VITE_COUNTER_CONTRACT_ADDRESS=
VITE_NOTEPAD_CONTRACT_ADDRESS=
# CourseMarket / YDToken / CertificateNFT — F03~F05 主合约地址
# 部署 Sepolia 后从 forge script 输出回填。
VITE_COURSE_MARKET_ADDRESS=
VITE_YD_TOKEN_ADDRESS=
VITE_CERTIFICATE_NFT_ADDRESS=
