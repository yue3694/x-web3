# Frontend RPC — public Sepolia endpoint by default; use Alchemy/Infura in prod.
# Vite exposes only vars prefixed with VITE_ to the client.
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Optional: WalletConnect Cloud project ID (only required if you add the
# walletConnect connector). https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: deployer address used as initialOwner when running scripts.
VITE_DEPLOYER_ADDRESS=